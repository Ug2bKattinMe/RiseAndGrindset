 <div class="stat card">
 <div class="label">Part B standard premium, 2026</div>
 <div class="value up">$202.90/mo</div>
 <div class="period">up 9.7% from $185.00 in 2025</div>
 </div>
 <div class="stat card">
 <div class="label">Part A inpatient deductible, 2026</div>
 <div class="value up">$1,736</div>
 <div class="period">up from $1,676 in 2025</div>
 </div>
 <div class="stat card">
 <div class="label">National Medicare spending, 2024</div>
 <div class="value up">+7.8%</div>
