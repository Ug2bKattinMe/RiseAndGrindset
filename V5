<script>
(function(){
  "use strict";

  var synth = window.speechSynthesis;
  var toolbar = document.getElementById('a11y-toolbar');
  var playBtn = document.getElementById('a11y-play');
  var pauseBtn = document.getElementById('a11y-pause');
  var stopBtn = document.getElementById('a11y-stop');
  var rateSelect = document.getElementById('a11y-rate');
  var statusEl = document.getElementById('a11y-status');

  if (!synth) {
    toolbar.classList.add('unsupported');
    statusEl.textContent = "Read-aloud isn't supported in this browser. Try Chrome, Edge, or Safari.";
    playBtn.disabled = true;
    return;
  }

  var sections = Array.prototype.slice.call(document.querySelectorAll('main > section'));
  var queue = [];       // ordered list of {text, sectionEl, label}
  var queueIndex = 0;
  var mode = null;      // 'all' | 'section' | null
  var activeSectionBtn = null;

  function cleanText(el){
    // Grab visible text, skip our own injected buttons
    var clone = el.cloneNode(true);
    var btns = clone.querySelectorAll('.section-read-btn');
    btns.forEach(function(b){ b.remove(); });
    var text = clone.textContent.replace(/\s+/g, ' ').trim();
    return text;
  }

  function buildQueueFromSection(sec){
    var h2 = sec.querySelector('h2');
    var label = h2 ? h2.textContent.trim() : 'Section';
    return [{ text: cleanText(sec), sectionEl: sec, label: label }];
  }

  function buildQueueFromAll(){
    return sections.map(function(sec){
      var h2 = sec.querySelector('h2');
      var label = h2 ? h2.textContent.trim() : 'Section';
      return { text: cleanText(sec), sectionEl: sec, label: label };
    });
  }

  function clearHighlight(){
    sections.forEach(function(s){ s.classList.remove('is-reading'); });
    document.querySelectorAll('.section-read-btn.reading').forEach(function(b){
      b.classList.remove('reading');
      b.textContent = '🔊 Read this section aloud';
    });
    activeSectionBtn = null;
  }

  function setToolbarState(playing, paused){
    playBtn.disabled = playing && !paused ? true : false;
    pauseBtn.disabled = !playing;
    stopBtn.disabled = !playing;
    pauseBtn.textContent = paused ? '▶ Resume' : '⏸ Pause';
  }

  function speakNext(){
    if (queueIndex >= queue.length) {
      statusEl.textContent = 'Finished reading.';
      clearHighlight();
      setToolbarState(false, false);
      mode = null;
      return;
    }
    var item = queue[queueIndex];
    item.sectionEl.classList.add('is-reading');
    item.sectionEl.scrollIntoView({ behavior: 'smooth', block: 'start' });

    var btn = item.sectionEl.querySelector('.section-read-btn');
    if (btn) {
      btn.classList.add('reading');
      btn.textContent = '⏹ Stop reading';
      activeSectionBtn = btn;
    }

    statusEl.textContent = 'Reading: ' + item.label +
      (mode === 'all' ? ' (' + (queueIndex + 1) + ' of ' + queue.length + ')' : '');

    var utter = new SpeechSynthesisUtterance(item.text);
    utter.rate = parseFloat(rateSelect.value) || 1;
    utter.onend = function(){
      item.sectionEl.classList.remove('is-reading');
      if (btn) { btn.classList.remove('reading'); btn.textContent = '🔊 Read this section aloud'; }
      queueIndex++;
      speakNext();
    };
    utter.onerror = function(){
      item.sectionEl.classList.remove('is-reading');
      queueIndex++;
      speakNext();
    };
    synth.speak(utter);
    setToolbarState(true, false);
  }

  function startQueue(newQueue, newMode){
    synth.cancel();
    clearHighlight();
    queue = newQueue;
    queueIndex = 0;
    mode = newMode;
    speakNext();
  }

  function stopAll(){
    synth.cancel();
    clearHighlight();
    setToolbarState(false, false);
    statusEl.textContent = 'Stopped.';
    mode = null;
  }

  // Toolbar controls
  playBtn.addEventListener('click', function(){
    startQueue(buildQueueFromAll(), 'all');
  });

  pauseBtn.addEventListener('click', function(){
    if (synth.speaking && !synth.paused) {
      synth.pause();
      setToolbarState(true, true);
      statusEl.textContent = 'Paused.';
    } else if (synth.paused) {
      synth.resume();
      setToolbarState(true, false);
    }
  });

  stopBtn.addEventListener('click', stopAll);

  rateSelect.addEventListener('change', function(){
    // Rate applies to the next utterance; restart current item at new rate for immediate effect
    if (synth.speaking) {
      var wasIndex = queueIndex;
      synth.cancel();
      queueIndex = wasIndex;
      speakNext();
    }
  });

  // Inject a "read this section" button into every section
  sections.forEach(function(sec, i){
    var h2 = sec.querySelector('h2');
    if (!h2) return;
    if (!h2.id) h2.id = 'section-heading-' + i;
    sec.setAttribute('aria-labelledby', h2.id);

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'section-read-btn';
    btn.textContent = '🔊 Read this section aloud';
    btn.setAttribute('aria-label', 'Read the "' + h2.textContent.trim() + '" section aloud');

    btn.addEventListener('click', function(){
      var isThisReading = sec.classList.contains('is-reading') && mode === 'section';
      if (isThisReading) {
        stopAll();
      } else {
        startQueue(buildQueueFromSection(sec), 'section');
      }
    });

    h2.insertAdjacentElement('afterend', btn);
  });

})();
</script>
